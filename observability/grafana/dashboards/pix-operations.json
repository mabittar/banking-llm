{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "Operações PIX",
  "tags": ["langchain-pix", "pix"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Operações PIX por intent e resultado (ops/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (intent, result) (rate(pix_operations_total[5m]))",
          "legendFormat": "{{intent}} / {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duração p95 por nó do grafo (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(graph_node_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{node}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bloqueios do guardrail (eventos/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(guardrail_block_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens LLM (tokens/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (llm_model) (rate(llm_token_count_total[5m]))",
          "legendFormat": "{{llm_model}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  }
}
