# ===========================================
# LangChain Pix Environment - Configuração
# ===========================================

# Ambiente (local | development)
ENVIRONMENT=local

# ----- LLM - OpenRouter (produção) -----
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# ----- LLM - Model FineTunning -----
LLM_TEMPERATURE=0.1
LLM_TOP_K=0
LLM_TOP_P=0

# ----- LLM - Ollama (desenvolvimento local) -----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

# ----- Guardrail -----
GUARDRAIL_ENABLED=true
GUARDRAIL_MODEL=meta-llama/llama-guard-4-12b
GUARDRAIL_THRESHOLD=0.7

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=null

# ----- PostgreSQL -----
DBNAME=banking-llm
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_HOST=localhost
DB_PORT=5433

# ----- Banking API -----
CLIENT_ID=client
REALM_NAME=tech
BANKING_BASE_URL=
JWT_SECRET=your-jwk-ec-private-key-here
FIN_ACCOUNT_ID=your-fin-account-id-here
FIN_ACCOUNT_ID_FALLBACK=your-fallback-account-id-here
TRANSACTION_HASH_SECRET=your-fin-account-transaction-hash-secret-key-here
AUDIENCE=your-audience-here

# ----- Observabilidade (OpenTelemetry) -----
OTEL_ENABLED=false
OTEL_SERVICE_NAME=langchain-pix-environment
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRICS_ENABLED=true
OTEL_LOGS_EXPORT_ENABLED=true

# ----- Grafana MCP (read-only) - opcional -----
GRAFANA_MCP_ENABLED=false
GRAFANA_URL=http://grafana:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=